root = true

# Global settings (applies to all files)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

# HTML files
[*.html]
indent_size = 2
indent_style = space
max_line_length = 120

# Javascript files
[*.js]
indent_size = 2
indent_style = space
max_line_length = 100

# JSON files
[*.json]
indent_size = 4
indent_style = space

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.yml]
indent_style = space
indent_size = 4
